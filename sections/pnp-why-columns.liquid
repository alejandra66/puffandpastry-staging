{% comment %}
  PNP – Why Choose Us (3–4 columns)
  Icon (emoji or small SVG/HTML), title, and text. Collapses to 1–2 columns on small screens.
{% endcomment %}
<section class="section section--pnp-why" style="max-width:1100px;margin:0 auto;padding:48px 16px;">
    {% if section.settings.heading != blank %}
        <h2 style="margin:0 0 24px 0;text-align:center;">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="why-grid" style="display:grid;gap:24px;grid-template-columns:repeat(3,minmax(0,1fr));">
        {% for block in section.blocks %}
            <div class="why-card" style="padding:20px;border:1px solid rgba(0,0,0,.08);border-radius:12px;background:#fff;">
                {% if block.settings.icon != blank %}
                    <div style="font-size:40px;line-height:1;margin-bottom:8px;text-align:center;">{{ block.settings.icon }}</div>
                {% endif %}
                {% if block.settings.title != blank %}
                    <h3 style="margin:8px 0 8px 0;text-align:center;">{{ block.settings.title }}</h3>
                {% endif %}
                {% if block.settings.text != blank %}
                    <div class="rte" style="text-align:center;color:rgba(0,0,0,.8);">{{ block.settings.text }}</div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
</section>

<style>
    @media (max-width: 980px){
        .section--pnp-why .why-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
    }
    @media (max-width: 640px){
        .section--pnp-why .why-grid { grid-template-columns: 1fr; }
    }
</style>

{% schema %}
{
  "name": "PNP Why columns",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "why_item",
      "name": "Why item",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji or HTML)", "default": "✨" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "PNP Why columns" }]
}
{% endschema %}
