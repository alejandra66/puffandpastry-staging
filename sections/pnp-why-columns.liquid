{% comment %}
  PNP – Why columns
  Variant "home-strip" renders a full-width dark band with 3–4 tiles
  Variant "cards" renders raised white cards (previous behavior)
{% endcomment %}

{%- comment -%} Compute flags without inline comparisons in {{ ... }} {%- endcomment -%}
{% if section.settings.variant == 'home-strip' %}
    {% assign is_strip = true %}
{% else %}
    {% assign is_strip = false %}
{% endif %}

{%- comment -%} Desktop columns: 3 by default, 4 when 4+ blocks {%- endcomment -%}
{% assign col_class = 'cols-3' %}
{% if section.blocks.size >= 4 %}
    {% assign col_class = 'cols-4' %}
{% endif %}

<section
        class="section section--pnp-why{% if is_strip %} pnp-why--strip{% endif %}"
        {% if is_strip %}style="background: {{ section.settings.strip_bg }}; color: {{ section.settings.strip_text }};"{% endif %}
>
    <div class="pnp-why__inner"
         style="max-width:1200px;margin:0 auto;{% if is_strip %}padding:36px 16px;{% else %}padding:48px 16px;{% endif %}">
        {% if section.settings.heading != blank %}
            <h2 class="pnp-why__heading"
                style="margin:0 0 24px 0;text-align:center;{% if is_strip %}color:{{ section.settings.strip_text }}{% endif %}">
                {{ section.settings.heading }}
            </h2>
        {% endif %}

        <div class="why-grid {{ col_class }}">
            {% for block in section.blocks %}
                {% if is_strip %}
                    {%- comment -%} Home-style strip item {%- endcomment -%}
                    <div class="why-item" style="text-align:center;">
                        {% if block.settings.icon != blank %}
                            <div class="why-icon" style="font-size:28px;line-height:1;margin-bottom:10px;opacity:.95;">
                                {{ block.settings.icon }}
                            </div>
                        {% endif %}
                        {% if block.settings.title != blank %}
                            <div class="why-title" style="font-weight:800;letter-spacing:.06em;text-transform:uppercase;margin:0 0 6px 0;">
                                {{ block.settings.title }}
                            </div>
                        {% endif %}
                        {% if block.settings.text != blank %}
                            <div class="why-text" style="opacity:.85;">
                                {{ block.settings.text }}
                            </div>
                        {% endif %}
                    </div>
                {% else %}
                    {%- comment -%} Card variant (original) {%- endcomment -%}
                    <div class="why-card"
                         style="padding:24px;border-radius:16px;background:#fff;box-shadow:0 10px 24px rgba(0,0,0,.06);text-align:center;">
                        {% if block.settings.icon != blank %}
                            <div style="font-size:40px;line-height:1;margin-bottom:8px;">{{ block.settings.icon }}</div>
                        {% endif %}
                        {% if block.settings.title != blank %}
                            <h3 style="margin:8px 0 8px 0;">{{ block.settings.title }}</h3>
                        {% endif %}
                        {% if block.settings.text != blank %}
                            <div class="rte" style="color:rgba(0,0,0,.8);">{{ block.settings.text }}</div>
                        {% endif %}
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>

<style>
    /* Grid columns */
    .section--pnp-why .why-grid { display:grid; gap:24px; }
    .section--pnp-why .why-grid.cols-3 { grid-template-columns: repeat(3, minmax(0,1fr)); }
    .section--pnp-why .why-grid.cols-4 { grid-template-columns: repeat(4, minmax(0,1fr)); }

    @media (max-width: 980px){
        .section--pnp-why .why-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
    }
    @media (max-width: 640px){
        .section--pnp-why .why-grid { grid-template-columns: 1fr; }
    }
</style>

{% schema %}
{
  "name": "PNP Why columns",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Choose Puff & Pastry" },
    {
      "type": "select", "id": "variant", "label": "Style variant",
      "options": [
        { "value": "home-strip", "label": "Home strip (dark band)" },
        { "value": "cards", "label": "Cards (raised white)" }
      ],
      "default": "home-strip"
    },
    { "type": "color", "id": "strip_bg", "label": "Strip background", "default": "#0e1a2b" },
    { "type": "color", "id": "strip_text", "label": "Strip text", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "why_item",
      "name": "Why item",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji or HTML)", "default": "✨" },
        { "type": "text", "id": "title", "label": "Title", "default": "Unique Flavors" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A rotating menu that changes weekly, keeping every box exciting.</p>" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "PNP Why columns (home strip)" }]
}
{% endschema %}
