{% comment %} PNP – Hero Banner (classic or home-card style, px/vh height) {% endcomment %}
<section class="pnp-hero" style="position:relative;overflow:hidden;">
    {% assign hero_img = section.settings.image %}
    {% if hero_img != blank %}
        {{ hero_img | image_url: width: 2400 | image_tag:
        loading: 'lazy',
        class: 'pnp-hero__img',
        alt: section.settings.heading | escape
        }}
    {% else %}
        <div class="pnp-hero__placeholder"></div>
    {% endif %}

    {%- comment -%} Base overlay {%- endcomment -%}
    <div class="pnp-hero__overlay"
         style="position:absolute;inset:0;background:rgba(0,0,0,{{ section.settings.overlay_opacity }});"></div>

    {%- comment -%} Optional vignette for home-card vibe {%- endcomment -%}
    {% if section.settings.vignette %}
        <div class="pnp-hero__vignette"
             style="position:absolute;inset:0;
                background: radial-gradient(80% 80% at 50% 50%, rgba(0,0,0,0.0) 30%, rgba(0,0,0,0.55) 100%);">
        </div>
    {% endif %}

    <div class="pnp-hero__content"
         style="position:absolute;inset:0;display:flex;align-items:center;justify-content:{{ section.settings.align }};padding:clamp(16px, 3vw, 48px);">
        {% comment %} Variant flags {% endcomment %}
        {% if section.settings.variant == 'home-card' %}
            {% assign is_card = true %}
        {% else %}
            {% assign is_card = false %}
        {% endif %}

        {% comment %} Text wrapper {% endcomment %}
        <div class="pnp-hero__text"
             style="max-width: {{ section.settings.text_max_width }}px; color:#fff; {% if is_card or section.settings.align == 'center' %}text-align:center; margin:0 auto;{% else %}text-align:left;{% endif %}">

            {% if section.settings.kicker != blank %}
                {% if is_card and section.settings.kicker_style == 'pill' %}
                    <span style="display:inline-block;padding:6px 10px;border-radius:999px;
                       background:rgba(255,255,255,.14); border:1px solid rgba(255,255,255,.35);
                       backdrop-filter: blur(4px); letter-spacing:.06em; text-transform:uppercase;
                       font-size:.8rem; margin-bottom:10px;">
            {{ section.settings.kicker }}
          </span>
                {% else %}
                    <div style="opacity:.9;margin-bottom:8px;">{{ section.settings.kicker }}</div>
                {% endif %}
            {% endif %}

            {% if section.settings.heading != blank %}
                <h1 style="margin:0 0 12px 0;line-height:1.05; {% if is_card %}text-transform:uppercase; letter-spacing:.02em;{% endif %}">
                    {{ section.settings.heading }}
                </h1>
            {% endif %}

            {% if section.settings.subheading != blank %}
                <p style="margin:0 0 16px 0;opacity:.95;font-size:1.125rem;">
                    {{ section.settings.subheading }}
                </p>
            {% endif %}

            {% if section.settings.btn_label != blank and section.settings.btn_link != blank %}
                <a href="{{ section.settings.btn_link }}"
                   class="btn"
                   style="display:inline-block;padding:12px 18px;border:1px solid #fff;color:#111;background:#fff;text-decoration:none;border-radius:999px;">
                    {{ section.settings.btn_label }}
                </a>
            {% endif %}
        </div>
    </div>
</section>

<style>
    /* Decide which height unit to use (no inline comparisons) */
    {% if section.settings.height_unit == 'px' %}
    {% assign use_px = true %}
    {% else %}
    {% assign use_px = false %}
    {% endif %}

    {% if use_px %}
    {% assign hero_h_desktop = section.settings.height_px | append: 'px' %}
    {% assign hero_h_mobile  = section.settings.height_mobile_px | append: 'px' %}
    {% else %}
    {% assign hero_h_desktop = section.settings.height | append: 'vh' %}
    {% assign hero_h_mobile  = section.settings.height_mobile | append: 'vh' %}
    {% endif %}

    .pnp-hero__img,
    .pnp-hero__placeholder{
        width:100%;
        height: {{ hero_h_desktop }};
        object-fit: cover;
        display:block;
    }
    @media (max-width: 768px){
        .pnp-hero__img,
        .pnp-hero__placeholder{
            height: {{ hero_h_mobile }};
        }
    }

    /* If using vh, add dvh fallback for better mobile stability */
    {% if use_px == false %}
    .pnp-hero__img,
    .pnp-hero__placeholder{
        height: {{ section.settings.height }}vh;
        height: {{ section.settings.height }}dvh;
    }
    @media (max-width: 768px){
        .pnp-hero__img,
        .pnp-hero__placeholder{
            height: {{ section.settings.height_mobile }}vh;
            height: {{ section.settings.height_mobile }}dvh;
        }
    }
    {% endif %}
</style>

{% schema %}
{
  "name": "PNP Hero banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gourmet cookies & desserts delivered fresh" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "btn_link", "label": "Button link" },

    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 0.7, "step": 0.1, "default": 0.5 },
    { "type": "checkbox", "id": "vignette", "label": "Add vignette glow (home-card look)", "default": true },

    { "type": "select", "id": "variant", "label": "Style variant",
      "options":[
        {"value":"classic","label":"Classic"},
        {"value":"home-card","label":"Home card (like homepage)"}
      ],
      "default":"home-card"
    },
    { "type": "select", "id": "kicker_style", "label": "Kicker style",
      "options":[
        {"value":"text","label":"Text"},
        {"value":"pill","label":"Pill (home-card)"}
      ],
      "default":"pill"
    },
    { "type": "range", "id": "text_max_width", "label": "Text max width (px)", "min": 320, "max": 1000, "step": 10, "default": 720 },

    { "type": "select", "id": "height_unit", "label": "Height unit",
      "options":[
        {"value":"vh","label":"Viewport (vh) – responsive"},
        {"value":"px","label":"Fixed (px) – same across browsers"}
      ],
      "default":"px"
    },

    { "type": "range", "id": "height", "label": "Desktop height (vh)", "min": 30, "max": 90, "step": 5, "default": 50 },
    { "type": "range", "id": "height_mobile", "label": "Mobile height (vh)", "min": 25, "max": 70, "step": 5, "default": 40 },

    { "type": "range", "id": "height_px", "label": "Desktop height (px)", "min": 240, "max": 800, "step": 10, "default": 420 },
    { "type": "range", "id": "height_mobile_px", "label": "Mobile height (px)", "min": 200, "max": 700, "step": 10, "default": 320 },

    { "type": "select", "id": "align", "label": "Text alignment",
      "options":[{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"}],
      "default":"center"
    }
  ],
  "presets": [{ "name": "PNP Hero banner" }]
}
{% endschema %}
