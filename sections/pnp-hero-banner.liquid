{% comment %} PNP – Hero Banner {% endcomment %}
<section class="pnp-hero" style="position:relative;overflow:hidden;">
    {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 2400 | image_tag:
        loading: 'lazy',
        class: 'pnp-hero__img',
        alt: section.settings.heading | escape
        }}
    {% else %}
        <div class="pnp-hero__placeholder" style="background:#ddd;height:{{ section.settings.height }}vh;"></div>
    {% endif %}

    <div class="pnp-hero__overlay" style="position:absolute;inset:0;background:linear-gradient(0deg, rgba(0,0,0,{{ section.settings.overlay_opacity }}), rgba(0,0,0,{{ section.settings.overlay_opacity }}));"></div>

    <div class="pnp-hero__content"
         style="position:absolute;inset:0;display:flex;align-items:center;justify-content:{{ section.settings.align }};padding:clamp(16px, 3vw, 48px);">
        <div style="max-width: 860px; color: #fff; text-align:{% if section.settings.align == 'center' %}center{% else %}left{% endif %};">
            {% if section.settings.kicker != blank %}<div style="opacity:.9;margin-bottom:8px;">{{ section.settings.kicker }}</div>{% endif %}
            {% if section.settings.heading != blank %}<h1 style="margin:0 0 12px 0;line-height:1.05;">{{ section.settings.heading }}</h1>{% endif %}
            {% if section.settings.subheading != blank %}<p style="margin:0 0 16px 0;opacity:.95;font-size:1.125rem;">{{ section.settings.subheading }}</p>{% endif %}
            {% if section.settings.btn_label != blank and section.settings.btn_link != blank %}
                <a href="{{ section.settings.btn_link }}" class="btn" style="display:inline-block;padding:12px 18px;border:1px solid #fff;color:#111;background:#fff;text-decoration:none;border-radius:999px;">
                    {{ section.settings.btn_label }}
                </a>
            {% endif %}
        </div>
    </div>
</section>

<style>
    .pnp-hero__img{width:100%;height:{{ section.settings.height }}vh;object-fit:cover;display:block;}
    @media (max-width: 768px){ .pnp-hero__img{ height: {{ section.settings.height_mobile }}vh; } }
</style>

{% schema %}
{
  "name": "PNP Hero banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gourmet cookies & desserts delivered fresh" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "btn_link", "label": "Button link" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity",
      "min": 0, "max": 0.7, "step": 0.1, "default": 0.4 },
    { "type": "range", "id": "height", "label": "Desktop height (vh)", "min": 40, "max": 90, "step": 5, "default": 60 },
    { "type": "range", "id": "height_mobile", "label": "Mobile height (vh)", "min": 30, "max": 70, "step": 5, "default": 45 },
    { "type": "select", "id": "align", "label": "Text alignment", "options":[
      {"value":"flex-start","label":"Left"},
      {"value":"center","label":"Center"}
    ], "default":"flex-start" }
  ],
  "presets": [{ "name": "PNP Hero banner" }]
}
{% endschema %}
