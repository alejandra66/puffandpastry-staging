{% comment %}
  Simple flexible rich text section with optional heading, text blocks, and a button.
  Drop-in replacement for Dawn's "rich-text".
{% endcomment %}

<section class="section section--pnp-rich-text" style="max-width: 880px; margin: 0 auto; padding: 32px 16px;">
    {% if section.settings.heading != blank %}
        <h2 class="pnp-rt__heading" style="margin:0 0 16px 0;">{{ section.settings.heading }}</h2>
    {% endif %}

    {% for block in section.blocks %}
        {% case block.type %}
            {% when 'heading' %}
                <h3 style="margin: 24px 0 8px 0;">{{ block.settings.heading }}</h3>
            {% when 'text' %}
                <div class="rte" style="margin: 0 0 16px 0;">{{ block.settings.text }}</div>
            {% when 'button' %}
                {% if block.settings.button_label != blank and block.settings.button_link != blank %}
                    <a href="{{ block.settings.button_link }}" class="btn" style="display:inline-block; padding:12px 18px; border:1px solid currentColor; text-decoration:none; margin-top:8px;">
                        {{ block.settings.button_label }}
                    </a>
                {% endif %}
        {% endcase %}
    {% endfor %}
</section>

{% schema %}
{
  "name": "PNP Rich text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    { "type": "heading", "name": "Subheading", "settings": [{ "type": "text", "id": "heading", "label": "Text" }] },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "text", "label": "Content" }] },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "button_label", "label": "Label" },
        { "type": "url", "id": "button_link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "PNP Rich text" }]
}
{% endschema %}
