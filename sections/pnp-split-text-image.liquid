{% comment %} PNP – Split: image + text {% endcomment %}
<section class="pnp-split" style="max-width:1200px;margin:0 auto;padding:56px 16px;">
    <div class="pnp-split__grid" style="display:grid;gap:32px;grid-template-columns:repeat(2,minmax(0,1fr));align-items:center;">

        {% if section.settings.image_position == 'left' %}
            <div>
                {% if section.settings.image != blank %}
                    {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'rounded-xl', alt: section.settings.heading | escape }}
                {% endif %}
            </div>
            <div>
                {% if section.settings.kicker != blank %}<div style="opacity:.7;margin-bottom:8px;">{{ section.settings.kicker }}</div>{% endif %}
                {% if section.settings.heading != blank %}<h2 style="margin:0 0 12px 0;">{{ section.settings.heading }}</h2>{% endif %}
                {% if section.settings.text != blank %}<div class="rte" style="margin-bottom:16px;">{{ section.settings.text }}</div>{% endif %}
                {% if section.settings.btn_label != blank and section.settings.btn_link != blank %}
                    <a href="{{ section.settings.btn_link }}" class="btn" style="display:inline-block;padding:12px 18px;border:1px solid currentColor;text-decoration:none;border-radius:999px;">
                        {{ section.settings.btn_label }}
                    </a>
                {% endif %}
            </div>
        {% else %}
            <div>
                {% if section.settings.kicker != blank %}<div style="opacity:.7;margin-bottom:8px;">{{ section.settings.kicker }}</div>{% endif %}
                {% if section.settings.heading != blank %}<h2 style="margin:0 0 12px 0;">{{ section.settings.heading }}</h2>{% endif %}
                {% if section.settings.text != blank %}<div class="rte" style="margin-bottom:16px;">{{ section.settings.text }}</div>{% endif %}
                {% if section.settings.btn_label != blank and section.settings.btn_link != blank %}
                    <a href="{{ section.settings.btn_link }}" class="btn" style="display:inline-block;padding:12px 18px;border:1px solid currentColor;text-decoration:none;border-radius:999px;">
                        {{ section.settings.btn_label }}
                    </a>
                {% endif %}
            </div>
            <div>
                {% if section.settings.image != blank %}
                    {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'rounded-xl', alt: section.settings.heading | escape }}
                {% endif %}
            </div>
        {% endif %}

    </div>
</section>

<style>
    @media(max-width: 900px){
        .pnp-split__grid{ grid-template-columns: 1fr; }
    }
</style>

{% schema %}
{
  "name": "PNP Split text + image",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image position (desktop)", "options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}], "default":"left" },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Story" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "btn_label", "label": "Button label" },
    { "type": "url", "id": "btn_link", "label": "Button link" }
  ],
  "presets": [{ "name": "PNP Split text + image" }]
}
{% endschema %}
