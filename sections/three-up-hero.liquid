{% endstylesheet %}

<script>
  /* Show mobile scroll-hint only when scrollable, hide after first swipe */
  document.addEventListener('DOMContentLoaded', function () {
    const root  = document.getElementById('three-up-hero-{{ section.id }}');
    if (!root) return;
    const track = root.querySelector('.three-up-hero__track');
    const hint  = root.querySelector('.three-up-hero__scroll-hint');
    const mq    = window.matchMedia('(max-width: 989px)');
    function updateVisibility() {
      if (!mq.matches || !track || !hint) { if (hint) hint.style.display = 'none'; return; }
      const canScroll = track.scrollWidth > track.clientWidth + 4;
      hint.style.display = canScroll && track.scrollLeft < 10 ? '' : 'none';
    }
    if (track && hint) {
      updateVisibility();
      track.addEventListener('scroll', function () {
        if (track.scrollLeft > 10) hint.style.display = 'none';
      }, { passive: true });
      window.addEventListener('resize', updateVisibility);
    }
  });
</script>
{% schema %}
{
  "name": "Three-up hero",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "height_vh", "label": "Height (vh)", "min": 40, "max": 90, "step": 1, "default": 70 },
    { "type": "range", "id": "gap", "label": "Gap (not used; tiles are flush)", "min": 0, "max": 32, "step": 1, "default": 0 },
    { "type": "range", "id": "overlay_strength", "label": "Default overlay strength", "min": 0, "max": 80, "step": 5, "default": 20 },
    { "type": "text", "id": "aria_label", "label": "ARIA label", "default": "Featured collections" },

    { "type": "checkbox", "id": "show_coming_soon", "label": "Show coming soon overlay", "default": true },
    { "type": "text",     "id": "cs_eyebrow", "label": "Overlay eyebrow", "default": "Beyond the Pastry" },
    { "type": "text",     "id": "cs_title",   "label": "Overlay title",   "default": "Coming soon" },
    { "type": "textarea", "id": "cs_copy",    "label": "Overlay copy",    "default": "We’re expanding our menu to bring you more than just baked goods. Stay tuned for what’s next." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow (small upper text)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Shop the collection" },
        { "type": "richtext", "id": "copy", "label": "Copy", "default": "<p></p>" },
        { "type": "range", "id": "overlay_strength_local", "label": "Overlay strength (override)", "min": 0, "max": 80, "step": 5, "default": 20 },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text position",
          "default": "bottom-left",
          "options": [
            { "value": "bottom-left", "label": "Bottom left" },
            { "value": "bottom-center", "label": "Bottom center" },
            { "value": "bottom-right", "label": "Bottom right" },
            { "value": "center", "label": "Center" }
          ]
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "Text alignment",
          "default": "left",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ]
        },
        { "type": "text", "id": "alt", "label": "Alt text (optional)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Three-up hero", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }
  ]
}
{% endschema %}
